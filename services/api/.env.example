# ==============================================================================
# REGNOVA FastAPI Backend Environment Configuration (.env)
# ==============================================================================
# Copy this file to 'services/api/.env' or root '.env'.
# Replace [YOUR_PASSWORD] with your actual Supabase database password.
# (Do NOT commit your actual '.env' file).

# ------------------------------------------------------------------------------
# 1. DATABASE_URL (Supabase PostgreSQL)
# ------------------------------------------------------------------------------

# OPTION A (RECOMMENDED - IPv4 Session Pooler):
# Use this if your internet/ISP does not support IPv6 or if direct connection times out.
# Port 5432 (Session Mode) or Port 6543 (Transaction Mode)
DATABASE_URL=postgresql://postgres.vaslxudowopjhvtzwfeo:[YOUR_PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require

# OPTION B (Direct Connection):
# DATABASE_URL=postgresql://postgres:[YOUR_PASSWORD]@db.vaslxudowopjhvtzwfeo.supabase.co:5432/postgres?sslmode=require

# OPTION C (Local SQLite Fallback):
# DATABASE_URL=sqlite:///./regnova.db

# ------------------------------------------------------------------------------
# 2. SUPABASE PROJECT API CONFIGURATION
# ------------------------------------------------------------------------------
SUPABASE_URL=https://vaslxudowopjhvtzwfeo.supabase.co
SUPABASE_ANON_KEY=[YOUR_SUPABASE_ANON_KEY]

# ------------------------------------------------------------------------------
# 3. SECURITY & AUTH
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=regnova-vystral-sih2026-supersecret-key-389148
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

ENVIRONMENT=development
PORT=8000
