# ==============================================================================
# REGNOVA Frontend Environment Configuration (apps/web/.env)
# ==============================================================================
# Copy this file to 'apps/web/.env' if you want direct Supabase client access in React.

# Backend API proxy URL (Leave blank to use default Vite proxy at /api/v1)
VITE_API_BASE_URL=

# Supabase Project Credentials (Optional for direct frontend client)
VITE_SUPABASE_URL=https://[YOUR_PROJECT_REF].supabase.co
VITE_SUPABASE_ANON_KEY=[YOUR_SUPABASE_ANON_PUBLISHABLE_KEY]
